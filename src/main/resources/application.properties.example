# Copie este arquivo para application.properties (mesma pasta).
# Configure a porta, o usuario e a senha da SUA instalacao local do MySQL.
# O banco 'aps_equipamentos' deve existir (veja database/create_database.sql).
# Nao envie application.properties com senhas para o GitHub.
db.url=jdbc:mysql://localhost:3306/aps_equipamentos?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
db.user=root
db.password=
